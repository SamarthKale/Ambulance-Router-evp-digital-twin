# Copy to .env (git-ignored) and adjust for your machine.

# SUMO install folder. Only needed if SUMO_HOME is not already set system-wide
# (or your terminal/VS Code was opened before it was set).
SUMO_HOME=C:\Program Files (x86)\Eclipse\Sumo

# Scenario, seed and demand scale for the backend (uvicorn) and `python -m simulation.sumo`.
EF_SCENARIO=grid2x2
EF_SEED=42
EF_SCALE=1.0
# 1.5 = heavy-traffic demo
# Live server: simulated seconds fast-forwarded at start and after Reset (traffic already flowing)
EF_WARMUP_S=120
# Live server: replay the first mission after each reset as an OFF ghost (a second SUMO
# process; 0 turns it off)
EF_GHOST=1
