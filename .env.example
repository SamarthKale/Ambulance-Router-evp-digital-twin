# Copy to .env (git-ignored) and adjust for your machine.

# SUMO install folder. Only needed if SUMO_HOME is not already set system-wide
# (or your terminal/VS Code was opened before it was set).
SUMO_HOME=C:\Program Files (x86)\Eclipse\Sumo

# Default scenario and seed for `python -m simulation.sumo`.
EF_SCENARIO=grid2x2
EF_SEED=42
