# Store text with LF in the repo; Windows checkouts convert as configured.
* text=auto

# 3D models go through Git LFS (CLAUDE.md section 11). Run `git lfs install` once per machine.
*.glb filter=lfs diff=lfs merge=lfs -text
# HDR environment maps (e.g. the delivered .exr skybox)
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
# Multi-file glTF deliveries: kept byte-exact (no line-ending conversion) and out of git history
3d_models/**/*.gltf filter=lfs diff=lfs merge=lfs -text
3d_models/**/*.bin filter=lfs diff=lfs merge=lfs -text
3d_models/**/*.png filter=lfs diff=lfs merge=lfs -text
3d_models/**/*.jpg filter=lfs diff=lfs merge=lfs -text
3d_models/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
